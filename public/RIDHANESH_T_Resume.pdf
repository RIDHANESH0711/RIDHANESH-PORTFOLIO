      <div class="skill-group">
        <div class="skill-group-label">Programming Languages</div>
        <div class="skill-tags">Python &nbsp;·&nbsp; Java &nbsp;·&nbsp; C</div>
      </div>
      <div class="skill-group">
        <div class="skill-group-label">Databases</div>
        <div class="skill-tags">MySQL &nbsp;·&nbsp; SQL</div>
      </div>
      <div class="skill-group">
        <div class="skill-group-label">AI / Machine Learning</div>
        <div class="skill-tags">Machine Learning (Fundamentals) &nbsp;·&nbsp; Computer Vision &nbsp;·&nbsp; Face Recognition &nbsp;·&nbsp; OpenCV</div>
