<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Ridhanesh T – Resume</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap');

  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    font-family: 'Inter', 'Segoe UI', Arial, sans-serif;
    font-size: 10.5pt;
    line-height: 1.45;
    color: #1a1a1a;
    background: #fff;
  }

  .page {
    width: 210mm;
    min-height: 297mm;
    max-height: 297mm;
    margin: 0 auto;
    padding: 11mm 14mm 10mm 14mm;
    overflow: hidden;
  }

  /* ── HEADER ── */
  .header {
    border-bottom: 2px solid #1a1a1a;
    padding-bottom: 7px;
    margin-bottom: 9px;
  }

  .name {
    font-size: 22pt;
    font-weight: 700;
    letter-spacing: -0.5px;
    color: #0f0f0f;
    line-height: 1.1;
  }

  .title-tag {
    font-size: 9pt;
    font-weight: 500;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: #1d6fa4;
    margin-top: 2px;
    margin-bottom: 6px;
  }

  .contact-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0 18px;
    font-size: 8.8pt;
    color: #333;
    font-weight: 400;
  }

  .contact-row span { white-space: nowrap; }

  .contact-row a {
    color: #1d6fa4;
    text-decoration: none;
  }

  /* ── SECTIONS ── */
  .section { margin-bottom: 8px; }

  .section-title {
    font-size: 8.5pt;
    font-weight: 700;
    letter-spacing: 1.8px;
    text-transform: uppercase;
    color: #1d6fa4;
    border-bottom: 1px solid #c8dce8;
    padding-bottom: 2px;
    margin-bottom: 5px;
  }

  /* ── TWO-COLUMN SKILLS ── */
  .skills-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0 24px;
  }

  .skill-group-label {
    font-size: 8.8pt;
    font-weight: 600;
    color: #1a1a1a;
    margin-bottom: 1px;
  }

  .skill-group {
    margin-bottom: 4px;
  }

  .skill-tags {
    font-size: 8.8pt;
    color: #2e2e2e;
  }

  /* ── EXPERIENCE / PROJECT ENTRIES ── */
  .entry { margin-bottom: 5px; }

  .entry-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 2px;
  }

  .entry-title {
    font-size: 9.5pt;
    font-weight: 600;
    color: #0f0f0f;
  }

  .entry-subtitle {
    font-size: 8.8pt;
    font-weight: 400;
    color: #444;
  }

  .entry-date {
    font-size: 8.5pt;
    color: #555;
    white-space: nowrap;
  }

  .entry-meta {
    font-size: 8.5pt;
    color: #1d6fa4;
    margin-bottom: 2px;
    font-style: italic;
  }

  ul.bullets {
    padding-left: 13px;
    margin-top: 2px;
  }

  ul.bullets li {
    font-size: 8.8pt;
    color: #222;
    margin-bottom: 1.5px;
    line-height: 1.4;
  }

  /* ── EDUCATION ── */
  .edu-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
  }

  .edu-main { font-size: 9.5pt; font-weight: 600; color: #0f0f0f; }
  .edu-sub   { font-size: 8.8pt; color: #444; }
  .edu-date  { font-size: 8.5pt; color: #555; }
  .edu-detail{ font-size: 8.5pt; color: #2e2e2e; margin-top: 1px; }

  /* ── CERTS ── */
  .cert-list {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 3px 16px;
  }

  .cert-item {
    font-size: 8.5pt;
    color: #2e2e2e;
    padding-left: 10px;
    position: relative;
  }

  .cert-item::before {
    content: '▸';
    position: absolute;
    left: 0;
    color: #1d6fa4;
    font-size: 8pt;
  }

  /* ── BOTTOM ROW ── */
  .bottom-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0 24px;
  }

  .soft-tags {
    font-size: 8.8pt;
    color: #2e2e2e;
    line-height: 1.6;
  }

  .lang-item {
    font-size: 8.8pt;
    color: #2e2e2e;
    line-height: 1.7;
  }

  /* ── SUMMARY ── */
  .summary-text {
    font-size: 8.8pt;
    color: #222;
    line-height: 1.5;
  }

  @media print {
    body { background: #fff; }
    .page { margin: 0; box-shadow: none; }
    a { color: #1d6fa4 !important; }
  }
</style>
</head>
<body>
<div class="page">

  <!-- HEADER -->
  <div class="header">
    <div class="name">RIDHANESH T</div>
    <div class="title-tag">B.Tech Artificial Intelligence &amp; Data Science</div>
    <div class="contact-row">
      <span>📍 Tiruppur, Tamil Nadu, India</span>
      <span>📞 +91 89256 33994</span>
      <span>✉ <a href="mailto:ridhan0711@gmail.com">ridhan0711@gmail.com</a></span>
